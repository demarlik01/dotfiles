# ----------------------------------------
# zimfw
# ----------------------------------------
ZIM_HOME=${ZDOTDIR:-${HOME}}/.zim
# 모듈 설치/업데이트
if [[ ! ${ZIM_HOME}/init.zsh -nt ${ZIM_CONFIG_FILE:-${ZDOTDIR:-${HOME}}/.zimrc} ]]; then
  source "$(brew --prefix zimfw)/share/zimfw.zsh" init
fi
source ${ZIM_HOME}/init.zsh

# ----------------------------------------
# 환경변수
# ----------------------------------------
export EDITOR="nvim"

# ----------------------------------------
# alias
# ----------------------------------------
alias vim="nvim"
alias dot="cd ~/dotfiles"
alias zshrc="nvim ~/.zshrc"
alias update-all="brew update && zimfw update && nvim --headless '+Lazy update' +qa && echo '=== All updated! ==='"
alias no-sleep="caffeinate"
# SSH 세션에서 로그인 키체인 잠금 해제 (GUI 로그인 없이 Keychain이 잠겨
# Claude Code가 MCP 인증 경고를 띄울 때 사용, 해당 세션 동안만 유효)
# 원인: https://github.com/anthropics/claude-code/issues/29816 / 우회 확인: issues/9403
alias unlock-keychain="security unlock-keychain ~/Library/Keychains/login.keychain-db"

# mac mini SSH 접속 + 로컬 포트 터널 (기본 18789): mini-tunnel [port]
# 셸을 쓰는 동안 localhost:<port> → mini:<port> 터널이 유지되고, exit 하면 같이 닫힌다
mini-tunnel() {
  local port="${1:-18789}"
  echo "tunnel: localhost:${port} → hyoseoks-mac-mini:${port}"
  ssh -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 \
    -L "${port}:127.0.0.1:${port}" hyo@hyoseoks-mac-mini
}

# ----------------------------------------
# 터미널 입력 모드 리셋
# ----------------------------------------
# SSH가 끊기는 등 원격 풀스크린 앱(tmux, nvim)이 종료 시퀀스를 못 보내면
# 마우스 추적/kitty 키보드 프로토콜이 켜진 채 남아 프롬프트에 `35;165;21M`
# 같은 파편이 찍힌다. 프롬프트마다 꺼 준다 (이미 꺼져 있으면 아무 효과 없음).
_reset_terminal_input_modes() {
  [[ -t 1 ]] || return 0
  printf '\e[?1000l\e[?1002l\e[?1003l\e[?1006l\e[?1015l\e[<u\e[=0;1u\e[?2004l'
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _reset_terminal_input_modes

# ----------------------------------------
# mise (runtime version manager)
# ----------------------------------------
eval "$(mise activate zsh)"

# ----------------------------------------
# starship prompt
# ----------------------------------------
eval "$(starship init zsh)"
